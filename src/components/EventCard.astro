---
interface Props {
  title: string;
  dept: string;
  date: string;
}
const { title, dept, date } = Astro.props as Props;
---

<div class="reveal-up flex items-start gap-4 rounded-2xl border border-parchment/10 bg-ink-light p-5 transition-colors hover:border-gold/40">
  <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-gold/10 font-display text-sm font-bold text-gold">
    {date}
  </div>
  <div>
    <h3 class="font-semibold text-parchment">{title}</h3>
    <p class="mt-1 text-xs uppercase tracking-widest text-teal/80">{dept}</p>
  </div>
</div>
