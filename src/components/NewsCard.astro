---
interface Props {
  title: string;
  date: string;
  category: string;
  snippet: string;
}

const { title, date, category, snippet } = Astro.props;
---

<article class="news-card">
  <div class="news-header">
    <span class="category-badge">{category}</span>
    <span class="news-date">{date}</span>
  </div>
  <h3 class="news-title">{title}</h3>
  <p class="news-snippet">{snippet}</p>
  <a href="#" class="read-more">
    Read More <span>→</span>
  </a>
</article>

<style>
  .news-card {
    border-radius: 1rem;
    border: 1px solid rgba(22, 35, 61, 0.15);
    background: linear-gradient(to bottom right, rgba(253, 240, 217, 0.6), rgba(253, 240, 217, 0.3));
    padding: 1.5rem;
    transition: all 0.5s ease-out;
  }

  .news-card:hover {
    border-color: rgba(200, 137, 42, 0.3);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .news-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .category-badge {
    display: inline-block;
    border-radius: 9999px;
    background-color: rgba(15, 138, 124, 0.2);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .news-date {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(22, 35, 61, 0.5);
  }

  .news-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-parchment);
    transition: color 0.3s ease-out;
  }


  .news-card:hover .news-title {
    color: var(--color-gold);
  }

  .news-snippet {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: rgba(22, 35, 61, 0.7);
    line-height: 1.5;
  }

  .read-more {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gold);
    transition: all 0.3s ease-out;
  }

  .read-more:hover {
    gap: 0.75rem;
  }

  .read-more span {
    transition: transform 0.3s ease-out;
  }

  .news-card:hover .read-more span {
    transform: translateX(0.25rem);
  }
</style>
