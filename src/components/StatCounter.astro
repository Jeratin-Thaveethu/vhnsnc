---
interface Props {
  value: number;
  suffix?: string;
  label: string;
}
const { value, suffix = "", label } = Astro.props as Props;
---

<div class="reveal-up text-center">
  <p class="font-display text-4xl font-bold text-gold sm:text-5xl">
    <span data-counter={value}>0</span>{suffix}
  </p>
  <p class="mt-2 text-sm uppercase tracking-widest text-parchment/60">{label}</p>
</div>
