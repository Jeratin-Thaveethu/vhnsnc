---
interface Props {
  name: string;
  icon: string;
  description: string;
}

const { name, icon, description } = Astro.props;
---

<div class="facility-card">
  <div class="facility-icon-wrapper">
    <div class="facility-icon">{icon}</div>
  </div>
  <h3 class="facility-name">{name}</h3>
  <p class="facility-description">{description}</p>
</div>

<style>
  .facility-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(22, 35, 61, 0.15);
    background: linear-gradient(to bottom right, rgba(253, 240, 217, 0.6), rgba(253, 240, 217, 0.4), rgba(253, 240, 217, 0.2));
    padding: 1.5rem;
    transition: all 0.5s ease-out;
  }

  /* Animated background on hover */
  .facility-card::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease-out;
    background: radial-gradient(circle at top left, rgba(15, 138, 124, 0.1), transparent);
    pointer-events: none;
  }

  .facility-card:hover::before {
    opacity: 1;
  }

  .facility-card:hover {
    border-color: rgba(15, 138, 124, 0.4);
    box-shadow: 0 10px 30px rgba(15, 138, 124, 0.1);
  }

  .facility-icon-wrapper {
    display: inline-block;
    margin-bottom: 1rem;
    border-radius: 9999px;
    background: linear-gradient(to bottom right, rgba(243, 197, 104, 0.1), rgba(15, 138, 124, 0.1));
    padding: 0.75rem;
    transition: all 0.5s ease-out;
  }

  .facility-card:hover .facility-icon-wrapper {
    transform: scale(1.1);
    background: linear-gradient(to bottom right, rgba(243, 197, 104, 0.2), rgba(15, 138, 124, 0.2));
  }

  .facility-icon {
    font-size: 1.875rem;
  }

  .facility-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-parchment);
    transition: color 0.3s ease-out;
  }

  .facility-card:hover .facility-name {
    color: var(--color-gold);
  }

  .facility-description {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: rgba(22, 35, 61, 0.65);
    line-height: 1.5;
    transition: color 0.3s ease-out;
  }

  .facility-card:hover .facility-description {
    color: rgba(22, 35, 61, 0.8);
  }

  /* Add subtle animation on card appearance */
  @keyframes cardEntry {
    from {
      @apply opacity-0 translate-y-2;
    }
    to {
      @apply opacity-100 translate-y-0;
    }
  }

  .facility-card {
    animation: cardEntry 0.6s ease-out forwards;
  }
</style>
