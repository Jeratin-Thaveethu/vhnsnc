---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="IQAC - VHNSNC">
  <main class="space-y-16 py-20">
    <!-- Hero Section -->
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        IQAC - Internal Quality Assurance Cell
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Committed to maintaining and enhancing academic quality and institutional excellence
      </p>
    </section>

    <!-- IQAC Information -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <h2 class="font-display text-2xl font-semibold text-gold mb-4">Vision & Mission</h2>
        <p class="text-parchment/80 leading-relaxed mb-4">
          The IQAC works towards sustaining and promoting measures for qualitative improvement in the institution's functioning.
        </p>
        <p class="text-parchment/70">
          Our mission is to ensure quality in teaching-learning, research, and academic services to meet societal expectations and accreditation standards.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Objectives</h3>
          <ul class="space-y-2 text-parchment/70 text-sm">
            <li>• Quality enhancement in teaching and learning</li>
            <li>• Research promotion and support</li>
            <li>• Institutional accreditation</li>
            <li>• Student welfare and development</li>
          </ul>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Functions</h3>
          <ul class="space-y-2 text-parchment/70 text-sm">
            <li>• Monitoring educational standards</li>
            <li>• Academic and administrative planning</li>
            <li>• Feedback mechanism implementation</li>
            <li>• Quality audit and evaluation</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
