---
import BaseLayout from "../layouts/BaseLayout.astro";
import { news, events } from "../data/college";
---

<BaseLayout title="News & Events - VHNSNC">
  <main class="space-y-16 py-20">
    <!-- Hero Section -->
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        News & Events
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Stay updated with latest happenings at VHNSNC
      </p>
    </section>

    <!-- Events Section -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <h2 class="text-center font-display text-3xl font-bold text-gold">Upcoming Events</h2>
      <div class="space-y-4">
        {events.map((event) => (
          <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6 hover:border-gold/30 transition-all">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div>
                <h3 class="font-display text-lg font-semibold text-parchment">{event.title}</h3>
                <p class="text-sm text-parchment/60 mt-1">{event.dept}</p>
                {event.description && <p class="text-parchment/70 mt-2">{event.description}</p>}
              </div>
              <div class="flex-shrink-0 text-right">
                <p class="text-lg font-bold text-gold">{event.date}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- News Section -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <h2 class="text-center font-display text-3xl font-bold text-gold">Latest News</h2>
      <div class="space-y-4">
        {news.map((newsItem) => (
          <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6 hover:border-gold/30 transition-all">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-gold/20 text-gold">
                    {newsItem.category}
                  </span>
                  <span class="text-xs text-parchment/60">{newsItem.date}</span>
                </div>
                <h3 class="font-display text-lg font-semibold text-parchment mb-2">{newsItem.title}</h3>
                <p class="text-parchment/70">{newsItem.snippet}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
