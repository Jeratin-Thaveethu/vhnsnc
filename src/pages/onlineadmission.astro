---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Online Admission - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        Online Admission Portal
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Seamless online application for UG and PG programs
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <div class="text-6xl mb-4">📝</div>
        <h2 class="font-display text-2xl font-semibold text-parchment mb-4">Quick and Easy Application</h2>
        <p class="text-parchment/80 mb-6">
          Apply online for your preferred program with our simplified admission process. Complete your application in just a few steps.
        </p>
        <a href="https://vhnsnc.edu.in/onlineadmission.php" target="_blank" rel="noopener noreferrer" class="inline-block rounded-full bg-gold px-8 py-3 text-lg font-semibold text-ink hover:shadow-lg hover:shadow-gold/30 transition-all">
          Open Application Portal →
        </a>
      </div>

      <h3 class="text-center font-display text-2xl font-semibold text-parchment">How It Works</h3>
      <div class="space-y-4">
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gold text-ink font-bold">1</div>
          </div>
          <div>
            <h4 class="font-semibold text-parchment">Register Your Account</h4>
            <p class="text-parchment/70">Create your login credentials with your email and phone number</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gold text-ink font-bold">2</div>
          </div>
          <div>
            <h4 class="font-semibold text-parchment">Fill Application Form</h4>
            <p class="text-parchment/70">Complete all required fields with accurate information</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gold text-ink font-bold">3</div>
          </div>
          <div>
            <h4 class="font-semibold text-parchment">Upload Documents</h4>
            <p class="text-parchment/70">Submit scanned copies of certificates and relevant documents</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gold text-ink font-bold">4</div>
          </div>
          <div>
            <h4 class="font-semibold text-parchment">Submit Application</h4>
            <p class="text-parchment/70">Review and submit your application form</p>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
        <h3 class="font-semibold text-parchment mb-3">Required Documents</h3>
        <ul class="space-y-2 text-parchment/70 text-sm">
          <li>• 10+2 or equivalent qualification certificate</li>
          <li>• Community certificate (if applicable)</li>
          <li>• Transfer certificate from previous college</li>
          <li>• Conduct certificate</li>
          <li>• Two passport-size photographs</li>
          <li>• Valid ID proof</li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
