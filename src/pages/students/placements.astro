---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Placements & Internships - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Placements & Career Development
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Preparing students for successful careers
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <div class="text-6xl mb-4">🎯</div>
        <h2 class="font-display text-2xl font-semibold text-parchment mb-4">Excellence in Placements</h2>
        <p class="text-parchment/80">
          Our placement cell works continuously to provide internship and placement opportunities to our students.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Top Recruiters</h3>
          <p class="text-parchment/70 text-sm">Leading companies in IT, Finance, Manufacturing, and Services sectors visit our campus.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Career Development</h3>
          <p class="text-parchment/70 text-sm">Regular workshops and training sessions to develop soft skills and technical expertise.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Alumni Network</h3>
          <p class="text-parchment/70 text-sm">Strong alumni presence in leading organizations aids networking and mentoring.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Internship Programs</h3>
          <p class="text-parchment/70 text-sm">Structured internship opportunities with industry partners during academic session.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
