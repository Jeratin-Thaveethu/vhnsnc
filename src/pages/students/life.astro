---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { studentActivityImages } from "../../data/college";
---

<BaseLayout title="Student Life & Activities - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Student Life
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Beyond the Classroom - A Holistic Experience
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <div class="mb-6 grid gap-4 md:grid-cols-3">
          {studentActivityImages.map((image) => (
            <figure class="overflow-hidden rounded-lg border border-parchment/15 bg-ink-light">
              <img src={image.src} alt={image.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
              <figcaption class="px-3 py-2 text-sm text-parchment/75">{image.title}</figcaption>
            </figure>
          ))}
        </div>
        <h2 class="font-display text-2xl font-semibold text-parchment mb-4">Enriching Campus Experience</h2>
        <p class="text-parchment/80">
          Our college provides numerous opportunities for personal growth, skill development, and social engagement.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Co-curricular Activities</h3>
          <p class="text-parchment/70 text-sm">Participate in debates, seminars, workshops, and cultural programs.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Sports & Recreation</h3>
          <p class="text-parchment/70 text-sm">Cricket, volleyball, badminton, table tennis, and athletics programs.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Student Support</h3>
          <p class="text-parchment/70 text-sm">Counseling, mentoring, and guidance for academic and personal development.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">Hostel Facilities</h3>
          <p class="text-parchment/70 text-sm">Safe and comfortable accommodation with modern amenities.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
