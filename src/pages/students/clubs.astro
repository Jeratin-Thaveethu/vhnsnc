---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Student Clubs & Organizations - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Student Clubs & Organizations
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Diverse opportunities for personal development and leadership
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <h2 class="font-display text-2xl font-semibold text-parchment mb-6">Our Clubs</h2>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">📚 Literary Club</h3>
            <p class="text-parchment/70 text-sm mt-2">Discussions, debates, and creative writing activities</p>
          </div>
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">🎨 Art & Culture Club</h3>
            <p class="text-parchment/70 text-sm mt-2">Traditional and contemporary art forms</p>
          </div>
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">🔬 Science Club</h3>
            <p class="text-parchment/70 text-sm mt-2">Research, experiments, and STEM activities</p>
          </div>
          <div className="rounded-lg border border-parchment/20 p-4">
            <h3 className="font-semibold text-parchment">⚽ Sports Club</h3>
            <p className="text-parchment/70 text-sm mt-2">Athletics, games, and fitness programs</p>
          </div>
          <div className="rounded-lg border border-parchment/20 p-4">
            <h3 className="font-semibold text-parchment">💻 Technical Club</h3>
            <p className="text-parchment/70 text-sm mt-2">Coding, computing, and IT workshops</p>
          </div>
          <div className="rounded-lg border border-parchment/20 p-4">
            <h3 className="font-semibold text-parchment">🤝 Social Service Club</h3>
            <p className="text-parchment/70 text-sm mt-2">Community engagement and social responsibility</p>
          </div>
        </div>
      </div>

      <div className="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
        <h3 className="font-semibold text-parchment mb-3">Club Benefits</h3>
        <ul className="space-y-2 text-parchment/70 text-sm">
          <li>• Leadership and management experience</li>
          <li>• Networking with peers and mentors</li>
          <li>• Skill development and personal growth</li>
          <li>• Recognition and awards</li>
          <li>• Fun and memorable experiences</li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
