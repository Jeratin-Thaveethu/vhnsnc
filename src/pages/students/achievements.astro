---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Student Achievements - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="space-y-6 px-6 text-center">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">Student Achievements</h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Celebrating student achievement in academics, sports, culture, and innovation.
      </p>
    </section>

    <section class="mx-auto max-w-4xl space-y-6 px-6">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <h2 class="font-display text-2xl font-semibold text-parchment">A Culture of Achievement</h2>
        <p class="mt-3 text-parchment/75">VHNSNC students bring curiosity, discipline, and teamwork to every opportunity.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {[
          ["Academic Excellence", "University ranks, academic distinctions, and departmental recognition."],
          ["Sports & Fitness", "Inter-collegiate competitions and representation in sporting events."],
          ["Arts & Culture", "Participation and awards in literary, cultural, and performing arts events."],
          ["Innovation & Service", "Hackathons, entrepreneurship, outreach, and community initiatives."],
        ].map(([title, description]) => (
          <article class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
            <h3 class="font-semibold text-parchment">{title}</h3>
            <p class="mt-2 text-sm text-parchment/70">{description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>