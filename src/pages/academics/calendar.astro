---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Academic Calendar - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Academic Calendar
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Academic Year 2025-2026 Timeline
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <h2 class="font-display text-2xl font-semibold text-parchment mb-6">Important Dates</h2>
        <div class="space-y-4">
          <div class="flex justify-between items-center border-b border-parchment/20 pb-3">
            <div>
              <h3 class="font-semibold text-parchment">Admission Process</h3>
              <p class="text-parchment/70 text-sm">Online and offline admission</p>
            </div>
            <span class="text-gold font-semibold text-sm">June-July 2025</span>
          </div>
          <div class="flex justify-between items-center border-b border-parchment/20 pb-3">
            <div>
              <h3 class="font-semibold text-parchment">Semester I Classes Begin</h3>
              <p class="text-parchment/70 text-sm">Start of academic year</p>
            </div>
            <span class="text-gold font-semibold text-sm">August 2025</span>
          </div>
          <div class="flex justify-between items-center border-b border-parchment/20 pb-3">
            <div>
              <h3 class="font-semibold text-parchment">Mid-Semester Exams</h3>
              <p class="text-parchment/70 text-sm">Continuous assessment</p>
            </div>
            <span class="text-gold font-semibold text-sm">October 2025</span>
          </div>
          <div class="flex justify-between items-center border-b border-parchment/20 pb-3">
            <div>
              <h3 class="font-semibold text-parchment">Semester I Exams</h3>
              <p class="text-parchment/70 text-sm">End-semester examination</p>
            </div>
            <span class="text-gold font-semibold text-sm">December 2025</span>
          </div>
          <div class="flex justify-between items-center border-b border-parchment/20 pb-3">
            <div>
              <h3 class="font-semibold text-parchment">Semester II Classes Begin</h3>
              <p class="text-parchment/70 text-sm">Second half of academic year</p>
            </div>
            <span class="text-gold font-semibold text-sm">January 2026</span>
          </div>
          <div class="flex justify-between items-center">
            <div>
              <h3 class="font-semibold text-parchment">Semester II Exams</h3>
              <p class="text-parchment/70 text-sm">End-semester examination</p>
            </div>
            <span class="text-gold font-semibold text-sm">April 2026</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
