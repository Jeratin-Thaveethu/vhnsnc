---
import BaseLayout from "../layouts/BaseLayout.astro";
import { officialGalleryImages } from "../data/college";
---

<BaseLayout title="Gallery - VHNSNC">
  <section class="px-6 pb-12 pt-32 text-center lg:px-10">
    <p class="reveal-fade text-sm font-semibold uppercase tracking-[0.3em] text-gold">Gallery</p>
    <h1 class="reveal-up mt-4 font-display text-4xl font-bold sm:text-5xl">
      Life on <span class="text-gold">Campus</span>
    </h1>
    <p class="reveal-up mx-auto mt-4 max-w-xl text-sm text-parchment/60">
      Official college announcements and highlights from the current academic year.
    </p>
  </section>

  <section class="px-6 pb-24 lg:px-10">
    <div class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {officialGalleryImages.map((img) => (
        <figure class:list={["reveal-up overflow-hidden rounded-lg border border-gold/20 bg-ink-light", { "sm:col-span-2 lg:col-span-4": img.wide }]}>
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class:list={["w-full object-cover object-top transition-transform duration-500 hover:scale-105", img.wide ? "aspect-[7/1]" : "aspect-[4/5]"]}
          />
          <figcaption class="border-t border-parchment/10 px-4 py-3 text-sm text-parchment/75">{img.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="px-6 pb-12 text-center lg:px-10">
    <div class="mx-auto max-w-2xl rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
      <h2 class="font-display text-2xl font-semibold text-parchment mb-4">Campus Categories</h2>
      <p class="text-parchment/70 text-sm mb-6">
        Our photo gallery includes infrastructure, academic facilities, student activities, sports, seminars, and memorable events.
      </p>
      <div class="grid grid-cols-2 gap-3 text-sm text-parchment/60">
        <span>🏛️ Infrastructure</span>
        <span>📚 Academics</span>
        <span>⚽ Sports</span>
        <span>🎓 Events</span>
        <span>👥 Student Life</span>
        <span>🏆 Achievements</span>
      </div>
    </div>
  </section>
</BaseLayout>
