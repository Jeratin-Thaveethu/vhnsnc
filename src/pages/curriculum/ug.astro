---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Undergraduate Curriculum - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Undergraduate Curriculum
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        3-Year Bachelor's Program Structure
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <h2 class="font-display text-2xl font-semibold text-parchment mb-6">Program Overview</h2>
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 rounded-full bg-gold/30 px-3 py-1 text-sm font-semibold text-gold">Sem 1-2</span>
            <div>
              <h3 class="font-semibold text-parchment">Foundation Year</h3>
              <p class="text-parchment/70 text-sm">Core concepts and basic principles across all disciplines</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 rounded-full bg-gold/30 px-3 py-1 text-sm font-semibold text-gold">Sem 3-4</span>
            <div>
              <h3 class="font-semibold text-parchment">Intermediate Year</h3>
              <p class="text-parchment/70 text-sm">Specialized coursework and practical applications</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 rounded-full bg-gold/30 px-3 py-1 text-sm font-semibold text-gold">Sem 5-6</span>
            <div>
              <h3 class="font-semibold text-parchment">Advanced Year</h3>
              <p class="text-parchment/70 text-sm">Research projects, electives, and capstone courses</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
        <h3 class="font-semibold text-parchment mb-3">Assessment Methods</h3>
        <ul class="space-y-2 text-parchment/70 text-sm">
          <li>• Continuous internal assessment and examinations</li>
          <li>• Practical sessions and laboratory work</li>
          <li>• Project submissions and presentations</li>
          <li>• End-semester examinations</li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
