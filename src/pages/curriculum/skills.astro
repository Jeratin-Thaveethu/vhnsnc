---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Skill Development - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Skill Development Programs
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Enhancing employability and professional competence
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <div class="text-6xl mb-4">🎯</div>
        <h2 class="font-display text-2xl font-semibold text-parchment mb-4">Beyond Academics</h2>
        <p class="text-parchment/80">
          Our comprehensive skill development initiatives prepare students for modern industry demands.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">📝 Soft Skills</h3>
          <ul class="space-y-1 text-parchment/70 text-sm">
            <li>• Communication Skills</li>
            <li>• Leadership Development</li>
            <li>• Team Building</li>
            <li>• Time Management</li>
          </ul>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">💻 Technical Skills</h3>
          <ul class="space-y-1 text-parchment/70 text-sm">
            <li>• Programming Languages</li>
            <li>• Software Development</li>
            <li>• Data Analysis</li>
            <li>• Digital Tools</li>
          </ul>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">🏆 Professional Certifications</h3>
          <ul class="space-y-1 text-parchment/70 text-sm">
            <li>• Industry Certifications</li>
            <li>• Language Proficiency</li>
            <li>• Technical Credentials</li>
            <li>• Professional Development</li>
          </ul>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-semibold text-parchment mb-3">🎓 Career Preparation</h3>
          <ul class="space-y-1 text-parchment/70 text-sm">
            <li>• Resume Writing</li>
            <li>• Interview Preparation</li>
            <li>• Job Search Strategies</li>
            <li>• Career Counseling</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
