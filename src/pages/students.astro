---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Students - VHNSNC">
  <main class="space-y-16 py-20">
    <!-- Hero Section -->
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        Student Life at VHNSNC
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Holistic development through academics, activities, and community engagement
      </p>
    </section>

    <!-- Quick Links -->
    <section class="flex flex-wrap gap-4 justify-center px-6">
      <a href="/students/life" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Student Life
      </a>
      <a href="/students/clubs" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Societies & Clubs
      </a>
      <a href="/students/achievements" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Achievements
      </a>
      <a href="/students/placements" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Placements
      </a>
    </section>

    <!-- Features Section -->
    <section class="px-6">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-6">
          <div class="text-4xl mb-3">🎭</div>
          <h3 class="font-display text-lg font-semibold text-parchment">Cultural Activities</h3>
          <p class="mt-2 text-parchment/70">Participate in annual fest, cultural programs, and talent showcases</p>
        </div>
        <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-6">
          <div class="text-4xl mb-3">🏆</div>
          <h3 class="font-display text-lg font-semibold text-parchment">Sports & Fitness</h3>
          <p class="mt-2 text-parchment/70">State-of-the-art sports facilities for multiple disciplines</p>
        </div>
        <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-6">
          <div class="text-4xl mb-3">📚</div>
          <h3 class="font-display text-lg font-semibold text-parchment">Clubs & Societies</h3>
          <p class="mt-2 text-parchment/70">Numerous student organizations for diverse interests</p>
        </div>
        <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-6">
          <div class="text-4xl mb-3">🤝</div>
          <h3 class="font-display text-lg font-semibold text-parchment">Community Service</h3>
          <p class="mt-2 text-parchment/70">Engage in social responsibility and community outreach</p>
        </div>
        <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-6">
          <div class="text-4xl mb-3">🎓</div>
          <h3 class="font-display text-lg font-semibold text-parchment">Mentoring Programs</h3>
          <p class="mt-2 text-parchment/70">Career guidance and academic support from experienced faculty</p>
        </div>
        <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-6">
          <div class="text-4xl mb-3">🏠</div>
          <h3 class="font-display text-lg font-semibold text-parchment">Hostel Facilities</h3>
          <p class="mt-2 text-parchment/70">Safe and comfortable accommodation with modern amenities</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
