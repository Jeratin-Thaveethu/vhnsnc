---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { principalPortrait } from "../../data/college";
---

<BaseLayout title="Principal - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Dr. A. Meenakshi
      </h1>
      <p class="text-lg text-parchment/70">Principal & Head, Department of Physics</p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <img src={principalPortrait.src} alt={principalPortrait.alt} class="mx-auto mb-6 h-32 w-32 rounded-full border border-gold/40 object-cover" />
        <h2 class="font-display text-2xl font-semibold text-parchment mb-4">Welcome</h2>
        <p class="text-parchment/80 leading-relaxed">
          Dr. A. Meenakshi has been leading VHNSNC with a vision to nurture excellence in academics, research, and overall development of students. With her dedicated leadership, the college has achieved significant milestones and recognition at national and state levels.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Academic Background</h3>
          <p class="text-parchment/70">Ph.D. in Physics with extensive research experience and publications in reputed journals.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Experience</h3>
          <p class="text-parchment/70">Over 25 years of experience in higher education and institutional management.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
