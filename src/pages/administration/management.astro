---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { managementImages } from "../../data/college";
---

<BaseLayout title="Management & Administration - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl">
        Management Committee
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Administrative Leadership
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <h2 class="font-display text-2xl font-semibold text-parchment mb-6">Governing Body</h2>
        <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {managementImages.map((member) => (
            <figure class="overflow-hidden rounded-lg border border-parchment/15 bg-ink-light text-center">
              <img src={member.src} alt={member.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
              <figcaption class="px-3 py-2 text-sm text-parchment/75">{member.name}</figcaption>
            </figure>
          ))}
        </div>
        <div class="space-y-4">
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">Secretary</h3>
            <p class="text-parchment/70 text-sm">Responsible for overall governance and policy decisions</p>
          </div>
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">Principal</h3>
            <p class="text-parchment/70 text-sm">Executive Head of the institution</p>
          </div>
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">Vice-Principal (Academics)</h3>
            <p class="text-parchment/70 text-sm">Oversees academic programs and faculty</p>
          </div>
          <div class="rounded-lg border border-parchment/20 p-4">
            <h3 class="font-semibold text-parchment">Vice-Principal (Administration)</h3>
            <p class="text-parchment/70 text-sm">Manages administrative and student affairs</p>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
        <h3 class="font-semibold text-parchment mb-3">Administrative Offices</h3>
        <ul class="space-y-2 text-parchment/70 text-sm">
          <li>• Registrar's Office</li>
          <li>• Finance & Accounts</li>
          <li>• Admission Cell</li>
          <li>• Examination Section</li>
          <li>• Student Welfare</li>
          <li>• Academic Coordination</li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
