---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="NIRF Ranking - VHNSNC">
  <main class="space-y-16 py-20">
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        NIRF Ranking
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        National Institutional Ranking Framework Recognition
      </p>
    </section>

    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8 text-center">
        <div class="text-6xl mb-4">⭐</div>
        <h2 class="font-display text-3xl font-semibold text-gold mb-4">Excellence in Rankings</h2>
        <p class="text-parchment/80 leading-relaxed mb-6">
          VHNSNC is recognized by the National Institutional Ranking Framework (NIRF) for its outstanding contributions to higher education and research.
        </p>
        <div class="grid gap-4 md:grid-cols-2 mt-8">
          <div class="rounded-lg bg-parchment/10 p-4">
            <p class="text-sm text-parchment/60 mb-2">NIRF Overall</p>
            <p class="text-2xl font-bold text-gold">Top 100</p>
          </div>
          <div class="rounded-lg bg-parchment/10 p-4">
            <p class="text-sm text-parchment/60 mb-2">College Category</p>
            <p class="text-2xl font-bold text-gold">Top Performer</p>
          </div>
        </div>
      </div>

      <h3 class="text-center font-display text-2xl font-semibold text-parchment">What This Means</h3>
      <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
        <ul class="space-y-3 text-parchment/70">
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Commitment to quality education and research</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Recognition for teaching excellence</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Strong faculty and research infrastructure</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Student satisfaction and outcomes</span>
          </li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
