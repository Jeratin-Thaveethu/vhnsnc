---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTAButton from "../components/CTAButton.astro";
import { admissionSteps, faqs } from "../data/college";
---

<BaseLayout title="Admissions" description="How to apply to VHNSNC.">
  <section class="px-6 pb-12 pt-32 text-center lg:px-10">
    <p class="reveal-fade text-sm font-semibold uppercase tracking-[0.3em] text-teal">Admissions</p>
    <h1 class="reveal-up mt-4 font-display text-4xl font-bold sm:text-5xl">
      Your Future Starts <span class="text-gradient-gold">Here</span>
    </h1>
    <div class="reveal-up mt-8">
      <CTAButton href="#apply-steps">See How It Works</CTAButton>
    </div>
  </section>

  <section id="apply-steps" class="px-6 py-20 lg:px-10">
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-4">
      {admissionSteps.map((s) => (
        <div class="reveal-up rounded-2xl border border-parchment/10 bg-ink-light p-7 transition-transform hover:-translate-y-2">
          <span class="font-display text-3xl font-bold text-gold/60">{s.step}</span>
          <h3 class="mt-4 font-semibold text-parchment">{s.title}</h3>
          <p class="mt-2 text-sm text-parchment/65">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-light/60 px-6 py-24 lg:px-10">
    <div class="mx-auto max-w-3xl">
      <h2 class="reveal-up mb-10 text-center font-display text-3xl font-bold">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((f, i) => (
          <details class="reveal-up faq-item rounded-2xl border border-parchment/10 bg-ink p-5 open:border-gold/40">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-parchment">
              {f.q}
              <span class="faq-icon ml-4 text-gold transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm text-parchment/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-24 text-center lg:px-10">
    <div class="reveal-up mx-auto max-w-2xl rounded-3xl border border-gold/30 bg-gradient-to-br from-ink-light to-ink p-12">
      <h2 class="font-display text-3xl font-bold">Applications for 2026 are open now</h2>
      <div class="mt-8">
        <CTAButton href="/contact">Talk to Admissions</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-item[open] .faq-icon {
    @apply rotate-45;
  }
</style>
