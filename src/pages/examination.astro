---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Examination - VHNSNC">
  <main class="space-y-16 py-20">
    <!-- Hero Section -->
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        Examination & Results
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Fair, transparent, and efficient examination system for academic evaluation
      </p>
    </section>

    <!-- Quick Links -->
    <section class="flex flex-wrap gap-4 justify-center px-6">
      <a href="/examination/schedule" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Exam Schedule
      </a>
      <a href="/examination/results" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Results
      </a>
      <a href="/examination/timetable" class="rounded-lg bg-gold/20 px-6 py-2 text-gold hover:bg-gold/30 transition-colors font-semibold">
        Time Table
      </a>
    </section>

    <!-- Examination System -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <h2 class="text-center font-display text-3xl font-bold text-gold">Our Examination System</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Continuous Assessment</h3>
          <p class="text-parchment/70">Periodic internal tests, assignments, and projects to evaluate student progress throughout the semester.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Semester Examinations</h3>
          <p class="text-parchment/70">Comprehensive end-semester examinations to assess overall understanding and knowledge.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Practical & Lab Exams</h3>
          <p class="text-parchment/70">Hands-on evaluation of practical skills and laboratory competencies.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Project Work</h3>
          <p class="text-parchment/70">Research-based projects to develop critical thinking and application skills.</p>
        </div>
      </div>
    </section>

    <!-- Important Information -->
    <section class="px-6 max-w-4xl mx-auto">
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <h3 class="font-display text-xl font-semibold text-gold mb-4">Important Notice</h3>
        <p class="text-parchment/80 mb-4">
          Students must adhere to the examination schedule and rules strictly. Any cases of malpractice will be dealt with as per college regulations.
        </p>
        <p class="text-parchment/70">
          For the latest examination schedules, results, and time tables, please visit the respective links or contact the Examination Cell.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
