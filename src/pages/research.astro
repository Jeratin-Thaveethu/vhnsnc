---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Research - VHNSNC">
  <main class="space-y-16 py-20">
    <!-- Hero Section -->
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        Research & Innovation
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Advancing knowledge and solving real-world problems through systematic research
      </p>
    </section>

    <!-- Research Overview -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <h2 class="text-center font-display text-3xl font-bold text-gold">Research Centers</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Science & Technology</h3>
          <p class="text-parchment/70">Research in Physics, Chemistry, Biology, and Computer Science focusing on applied sciences.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Social Sciences</h3>
          <p class="text-parchment/70">Studies in Economics, History, Literature, and Social Development.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Commerce & Management</h3>
          <p class="text-parchment/70">Business research, entrepreneurship, and management studies.</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Interdisciplinary Studies</h3>
          <p class="text-parchment/70">Collaborative research across multiple disciplines.</p>
        </div>
      </div>
    </section>

    <!-- Research Support -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <h2 class="text-center font-display text-3xl font-bold text-gold">Research Support</h2>
      <div class="rounded-lg border border-gold/30 bg-gradient-to-br from-gold/10 to-transparent p-8">
        <ul class="space-y-3 text-parchment/80">
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Funding and grants for research projects</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Well-equipped laboratories and research facilities</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Access to international journals and databases</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Collaborations with national and international institutions</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <span>Publication support and academic forums</span>
          </li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
