---
import BaseLayout from "../layouts/BaseLayout.astro";
import { digitechImages } from "../data/college";
---

<BaseLayout title="Digitech - VHNSNC">
  <main class="space-y-16 py-20">
    <!-- Hero Section -->
    <section class="relative space-y-6 text-center px-6">
      <h1 class="font-display text-4xl font-bold text-gold md:text-5xl lg:text-6xl">
        Digitech
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-parchment/70">
        Pioneering digital transformation and technological innovation at VHNSNC
      </p>
    </section>

    <!-- Services Section -->
    <section class="px-6 max-w-4xl mx-auto space-y-8">
      <h2 class="text-center font-display text-3xl font-bold text-gold">Our Services</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {digitechImages.map((image) => (
          <img src={image.src} alt={image.alt} class="aspect-video rounded-lg border border-gold/20 bg-white object-contain p-3" loading="lazy" />
        ))}
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <div class="text-4xl mb-3">💻</div>
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Web Development</h3>
          <p class="text-parchment/70">Custom web solutions and digital platforms for academic and administrative needs</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <div class="text-4xl mb-3">📱</div>
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Mobile Applications</h3>
          <p class="text-parchment/70">Mobile apps for student engagement and institutional management</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <div class="text-4xl mb-3">🔐</div>
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Cyber Security</h3>
          <p class="text-parchment/70">Protecting institutional data and ensuring secure digital infrastructure</p>
        </div>
        <div class="rounded-lg border border-parchment/20 bg-gradient-to-br from-parchment/5 to-transparent p-6">
          <div class="text-4xl mb-3">☁️</div>
          <h3 class="font-display text-lg font-semibold text-parchment mb-3">Cloud Solutions</h3>
          <p class="text-parchment/70">Cloud-based systems for scalability and accessibility</p>
        </div>
      </div>
    </section>

    <!-- Website Credit -->
    <section class="px-6 text-center max-w-4xl mx-auto">
      <p class="text-parchment/70">
        This website is developed and maintained by VHNSNC Digitech team.
      </p>
    </section>
  </main>
</BaseLayout>
